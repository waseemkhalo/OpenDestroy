# Values use JSON string quoting. Run scripts/init-backend.py to create real secrets.
# Speech keys are optional at startup; transcription reports unavailable until configured.
# Community operation uses local SQLite and operator-issued tokens only.
DESTROY_DATA_KEY="GENERATE_A_RANDOM_BASE64_32_BYTE_KEY"
DESTROY_USERS="{\"TOKEN_SHA256_HEX\":\"your-user-id\"}"
DESTROY_DB="data/dictation.sqlite"
DESTROY_LISTEN="127.0.0.1:8787"
GEMINI_API_KEY=""
GEMINI_PAID_PROJECT="false"
GEMINI_STT_MODEL="gemini-3.5-transcribe-live"
OPENAI_API_KEY=""
OPENAI_STT_MODEL="gpt-4o-mini-transcribe"
OPENAI_TEXT_MODEL="gpt-4.1-mini"
GIPHY_API_KEY=""
# Enable these only after obtaining the relevant GIPHY permissions. Flags are not approval.
GIPHY_PROXY_APPROVED="false"
GIPHY_MEDIA_URL_STORAGE_APPROVED="false"
GIPHY_FAVORITES_ORDER_APPROVED="false"
