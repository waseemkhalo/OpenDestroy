{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Destroy Dictation",
  "version": "0.1.0",
  "identifier": "org.destroy.dictation.community",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Destroy Dictation",
        "width": 680,
        "height": 700,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": true,
        "focus": false,
        "shadow": false,
        "visible": false,
        "minWidth": 540,
        "minHeight": 520
      },
      {
        "label": "dictation-hud",
        "title": "Destroy Dictation status",
        "width": 338,
        "height": 34,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "focus": false,
        "focusable": false,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://giphy.com https://*.giphy.com; media-src 'self' blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": false,
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist"
    },
    "icon": [
      "icons/icon.png"
    ]
  },
  "plugins": {}
}
