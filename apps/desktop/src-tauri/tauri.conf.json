{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenDestroy",
  "version": "0.1.1",
  "identifier": "org.destroy.dictation.community",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "OpenDestroy",
        "width": 1180,
        "height": 820,
        "decorations": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "alwaysOnTop": false,
        "resizable": true,
        "focus": false,
        "shadow": false,
        "visible": false,
        "minWidth": 540,
        "minHeight": 520
      },
      {
        "label": "dictation-hud",
        "title": "OpenDestroy status",
        "width": 338,
        "height": 34,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "focus": false,
        "focusable": false,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://giphy.com https://*.giphy.com; media-src 'self' blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": false,
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist",
      "dmg": {
        "background": "icons/dmg-background.png",
        "windowSize": { "width": 900, "height": 600 },
        "appPosition": { "x": 220, "y": 345 },
        "applicationFolderPosition": { "x": 680, "y": 345 }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
